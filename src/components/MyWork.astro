---
import { Image } from "astro:assets";
import LinkButton from "../components/LinkButton.astro";
import modeDS from "../assets/images/sample-sf-mode.png";
import colorPalette from "../assets/images/sample-mh-colors.png";
import homeScreen from "../assets/images/sample-mh-home.png";
import returnsProcess from "../assets/images/sample-sf-returns.png";
import globalNav from "../assets/images/sample-mh-nav.png";

const featuredStories = [
  {
    tags: ["Team leadership", "Operating model", "Enterprise platform"],
    title: "Leading and scaling product design at Tive",
    summary:
      "How I increased ownership across a senior design team while introducing stronger discovery, critique, validation, and shared product foundations.",
    proves: "I can inherit and lead a platform design team.",
    image: null,
  },
  {
    tags: ["Design systems", "Governance", "Design engineering"],
    title: "Scaling the Mode Design System at Stitch Fix",
    summary:
      "Helped grow adoption across 100+ product partners and 16 customer-facing teams through system architecture and design-engineering partnership.",
    proves: "I create organizational leverage, not just components.",
    image: modeDS,
    cta: {
      label: "Read on Medium",
      href: "https://yorthehunter.medium.com/introducing-the-mode-design-system-b3a64cb916da?sk=7450450ef476290ea72991dc0c0110c8",
    },
  },
  {
    tags: ["Complex workflows", "Hands-on design", "Measurable impact"],
    title: "Designing a returns process that reflects reality",
    summary:
      "Redesigned warehouse returns around real-world operations, increasing throughput by 50% and reducing errors by 15%.",
    proves: "I stay close to users, systems, and product craft.",
    image: returnsProcess,
    cta: {
      label: "View the Presentation",
      href: "https://www.figma.com/proto/wS6ueswXKU1mBg4spRq1C6/Portfolio-2023%E2%80%932024?node-id=765-370&node-type=section&t=OCbnbU6f7Ta94OPS-1&scaling=contain&content-scaling=fixed&page-id=762%3A18068",
    },
  },
];
---

<p>
  These are selected examples of the product and systems work that shaped how
  I lead today. They span design systems, platform architecture, product
  strategy, accessibility, and operational workflows—often at the
  intersection of design and engineering.
</p>
<p>
  I value documenting decisions, catering storytelling to your audience,
  trusting partnerships between teammates, and enacting process and automation
  at the right time.
</p>

<div class="featured-stories">
  {featuredStories.map((story, i) => (
    <article class="story" data-reverse={i % 2 === 1}>
      <div class="story-media">
        {story.image ? (
          <Image src={story.image} alt="" class="story-image" loading="lazy" />
        ) : (
          <div class="story-placeholder">Tive visual — coming soon</div>
        )}
      </div>
      <div class="story-content">
        <div class="story-tags">
          {story.tags.map((tag) => (
            <span class="story-chip">{tag}</span>
          ))}
        </div>
        <h3>{story.title}</h3>
        <p class="story-summary">{story.summary}</p>
        <blockquote class="story-proves">{story.proves}</blockquote>
        {story.cta && (
          <LinkButton newWindow label={story.cta.label} href={story.cta.href} />
        )}
      </div>
    </article>
  ))}
</div>

<section class="more-work">
  <h3>More work</h3>
  <ul>
    <li class="work-card">
      <Image
        src={colorPalette}
        alt="Color examples from the Vita Design System color palette"
        class="image"
        loading="lazy"
      />
      <section class="content">
        <h4>Creating an Accessible, Scalable Color Palette</h4>
        <p>
          Redesigned the color palette for all web and mobile platforms (member, provider, client) at Modern Health. Enabled
          WCAG-compliance at scale and an enhanced UX through better accessibility of design.
        </p>
        <LinkButton newWindow label="Read on Medium" href="https://yorthehunter.medium.com/how-we-created-an-accessible-scalable-color-palette-2ae1242abdcb" />
      </section>
    </li>
    <li class="work-card">
      <Image
        src={homeScreen}
        alt="Desktop and mobile views of the new home screen at Modern Health"
        class="image"
      />
      <section class="content">
        <h4>Launched a Personalized Home Screen</h4>
        <p>
          Designed a modular home screen, resulting in 25% higher retention, better user engagement, and the launch of algorithmically personalized content.
        </p>
        <LinkButton newWindow label="View the Presentation" href="https://www.figma.com/proto/wS6ueswXKU1mBg4spRq1C6/Portfolio-2023%E2%80%932024?page-id=808%3A11414&node-id=808-19544&node-type=section&t=vmCyw9LoND2kaYWq-0&scaling=min-zoom&content-scaling=fixed" />
      </section>
    </li>
    <li class="work-card">
      <Image
        src={globalNav}
        alt="A screenshot of the spec work for the Global Navigation in the Vita Design System from Modern Health"
        class="image"
        loading="lazy"
      />
      <section class="content">
        <h4>Launched Multi-platform Global Navigation</h4>
        <p>
          Componentized our global navigation across all platforms at Modern
          Health, enabling global search and increasing engagement by 35% with all
          member-facing products.
        </p>
        <span><em>Please Ask for Details About this Project</em></span>
      </section>
    </li>
  </ul>
</section>

<style lang="scss">
  p {
    font: var(--font-body-3);
  }

  .featured-stories {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    margin-top: var(--space-m);
  }

  .story {
    display: flex;
    flex-direction: row;
    gap: var(--space-l);
    align-items: center;

    &[data-reverse="true"] {
      flex-direction: row-reverse;
    }

    @media screen and (max-width: 720px) {
      flex-direction: column;
    }
  }

  .story-media {
    flex: 0 0 45%;
  }

  .story-image {
    width: 100%;
    height: auto;
    border-radius: 16px;
  }

  .story-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-soften);
    border-radius: 16px;
    font: var(--font-body-4);
    color: var(--color-secondary);
    text-align: center;
  }

  .story-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: start;
  }

  .story-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  .story-chip {
    font: var(--font-body-4);
    background: var(--color-bg-soften);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: 255px;
  }

  .story-content h3 {
    font: var(--font-heading-3);
  }

  .story-summary {
    font: var(--font-body-3);
  }

  .story-proves {
    font: var(--font-body-3);
    font-style: italic;
    border-left: 3px solid var(--color-vibrant);
    padding-left: var(--space-xs);
    margin: 0;
  }

  .more-work {
    margin-top: var(--space-2xl);

    > h3 {
      font: var(--font-heading-4);
      margin-bottom: var(--space-m);
    }
  }

  ul {
    list-style: none;
    display: flex;
    align-items: stretch;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .work-card {
    display: flex;
    flex-direction: row;
    gap: var(--space-s);
    border-radius: 20px;
    background: var(--color-vibrant-gradient);
    padding: var(--space-m) var(--space-m) 0;
    position: relative;

    @media screen and (max-width: 720px) {
      flex-direction: column;
    }

    &:hover .content {
      visibility: visible;
      opacity: 1;
    }

    .image {
      object-fit: contain;
      max-width: min(700px, 100%);
      height: auto;
      margin: auto;

      @media screen and (max-width: 812px) {
        max-width: 100%;
        width: 100%;
        object-fit: cover;
      }
    }

    .content {
      transition: visibility 0s, opacity 0.15s ease-in;
      visibility: hidden;
      opacity: 0;
      padding: var(--space-m) var(--space-m);
      border-radius: 20px;
      color: white;
      display: flex;
      justify-content: flex-end;
      flex-direction: column;
      gap: var(--space-xs);
      align-items: start;
      flex: 1;
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      right: 0;
      background-color: var(--color-bg-overlay-dark);

      > p {
        @media screen and (max-width: 812px) {
          display: none;
        }
      }
    }

    h4 {
      font: var(--font-heading-4);
    }

    p {
      font: var(--font-body-4);
    }
  }
</style>
