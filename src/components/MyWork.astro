---
import { Image } from "astro:assets";
import LinkButton from "../components/LinkButton.astro";
import modeDS from "../assets/images/sample-sf-mode.png";
import returnsProcess from "../assets/images/sample-sf-returns.png";

const featuredStories = [
  {
    tags: ["Team leadership", "Operating model", "Enterprise platform"],
    title: "Leading and scaling product design at Tive",
    summary:
      "How I increased ownership across a senior design team while introducing stronger discovery, critique, validation, and shared product foundations.",
    proves: "I can inherit and lead a platform design team.",
    image: null,
  },
  {
    tags: ["Design systems", "Governance", "Design engineering"],
    title: "Scaling the Mode Design System at Stitch Fix",
    summary:
      "Helped grow adoption across 100+ product partners and 16 customer-facing teams through system architecture and design-engineering partnership.",
    proves: "I create organizational leverage, not just components.",
    image: modeDS,
    cta: {
      label: "Read on Medium",
      href: "https://yorthehunter.medium.com/introducing-the-mode-design-system-b3a64cb916da?sk=7450450ef476290ea72991dc0c0110c8",
    },
  },
  {
    tags: ["Complex workflows", "Hands-on design", "Measurable impact"],
    title: "Designing a returns process that reflects reality",
    summary:
      "Redesigned warehouse returns around real-world operations, increasing throughput by 50% and reducing errors by 15%.",
    proves: "I stay close to users, systems, and product craft.",
    image: returnsProcess,
    cta: {
      label: "View the Presentation",
      href: "https://www.figma.com/proto/wS6ueswXKU1mBg4spRq1C6/Portfolio-2023%E2%80%932024?node-id=765-370&node-type=section&t=OCbnbU6f7Ta94OPS-1&scaling=contain&content-scaling=fixed&page-id=762%3A18068",
    },
  },
];
---

<p>
  These are selected examples of the product and systems work that shaped how
  I lead today. They span design systems, platform architecture, product
  strategy, accessibility, and operational workflows—often at the
  intersection of design and engineering.
</p>

<div class="featured-stories">
  {featuredStories.map((story, i) => (
    <article class="story" data-reverse={i % 2 === 1}>
      <div class="story-media">
        {story.image ? (
          <Image
            src={story.image}
            alt=""
            class="story-image"
            loading="lazy"
          />
        ) : (
          <div class="story-placeholder">Tive visual — coming soon</div>
        )}
      </div>
      <div class="story-content">
        <div class="story-tags">
          {story.tags.map((tag) => (
            <span class="story-chip">{tag}</span>
          ))}
        </div>
        <h3>{story.title}</h3>
        <p class="story-summary">{story.summary}</p>
        <blockquote class="story-proves">{story.proves}</blockquote>
        {story.cta && (
          <LinkButton newWindow label={story.cta.label} href={story.cta.href} />
        )}
      </div>
    </article>
  ))}
</div>

<style lang="scss">
  p {
    font: var(--font-body-3);
  }

  .featured-stories {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    margin-top: var(--space-m);
  }

  .story {
    display: flex;
    flex-direction: row;
    gap: var(--space-l);
    align-items: center;

    &[data-reverse="true"] {
      flex-direction: row-reverse;
    }

    @media screen and (max-width: 720px) {
      flex-direction: column;
    }
  }

  .story-media {
    flex: 0 0 45%;
    aspect-ratio: 3 / 2;
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-bg-soften);
  }

  .story-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font: var(--font-body-4);
    color: var(--color-secondary);
    text-align: center;
  }

  .story-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: start;
  }

  .story-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  .story-chip {
    font: var(--font-body-4);
    background: var(--color-bg-soften);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: 255px;
  }

  .story-content h3 {
    font: var(--font-heading-3);
  }

  .story-summary {
    font: var(--font-body-3);
  }

  .story-proves {
    font: var(--font-body-3);
    font-style: italic;
    border-left: 3px solid var(--color-vibrant);
    padding-left: var(--space-xs);
    margin: 0;
  }
</style>
