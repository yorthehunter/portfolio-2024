---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import MoreWork from "../components/MoreWork.astro";

const base = import.meta.env.BASE_URL;
---

<Layout title="Brian Cleveland: More Work">
  <TopNav />
  <main id="main">
    <article class="content-section" id="more-work">
      <h2 class="heading-3">More Work</h2>
      <p class="body-3">
        Earlier projects from my time at Modern Health. For the work that
        best represents how I lead today, see
        {" "}<a href={`${base}#my-work`}>Leadership Work</a> on the home page.
      </p>
      <MoreWork />
    </article>
    <footer>
      <p>
        This site was built with <a
          href="https://github.com/yorthehunter/portfolio-2024"
          target="_blank">Astro and SCSS</a
        >.
      </p>
    </footer>
  </main>
</Layout>
