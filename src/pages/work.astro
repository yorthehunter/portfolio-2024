---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import MyWork from "../components/MyWork.astro";
import MoreWork from "../components/MoreWork.astro";
---

<Layout title="Brian Cleveland: Work">
  <TopNav />
  <main id="main">
    <header class="content-section">
      <p class="eyebrow all-caps soft">Work</p>
      <h1 class="heading-2">
        Selected work that shows how I lead, build, and ship.
      </h1>
    </header>
    <article class="content-section" id="my-work">
      <MyWork />
    </article>
    <article class="content-section" id="more-work">
      <h2 class="heading-3">More Work</h2>
      <p class="body-3">Earlier projects from my time at Modern Health.</p>
      <MoreWork />
    </article>
    <footer>
      <p>
        This site was built with <a
          href="https://github.com/yorthehunter/portfolio-2024"
          target="_blank">Astro and SCSS</a
        >.
      </p>
    </footer>
  </main>
</Layout>
