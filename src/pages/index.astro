---
import Layout from "../layouts/Layout.astro";
import LinkButton from "../components/LinkButton.astro";
import TopNav from "../components/TopNav.astro";
// import Accomplishments from "../components/Accomplishments.astro";
import MyStory from "../components/MyStory.astro";
import MyWork from "../components/MyWork.astro";
import AboutMe from "../components/AboutMe.astro";
import Contact from "../components/Contact.astro";

const mhUrl = "https://www.modernhealth.com/";
const anomalieUrl =
  "https://www.retaildive.com/news/davids-bridal-acquires-custom-wedding-dress-startup-anomalie/623973/";
const sfUrl = "https://www.stitchfix.com/";
const modClothUrl = "http://www.modcloth.com";
const builtUrl = "http://www.getBuilt.com";
const tiveUrl = "http://www.tive.com";

const resumeUrl = "https://docs.google.com/document/d/1SaZ4JSDOMKmL3DXPAOlfW2wrOcPJz3YNPabrS91beSI/edit?usp=sharing"
const linkedinUrl = "https://www.linkedin.com/in/borudesign/"
const mediumUrl = "https://medium.com/@yorthehunter"
---

<Layout
  title="Brian Cleveland: Product design leader working across design systems, platforms, teams, and engineering."
>
  <TopNav />
  <main id="main">
    <header class="content-section">
      <p class="eyebrow all-caps soft">Brian Cleveland</p>
      <h1 class="heading-1">
        I build the teams, systems, and product foundations that help complex organizations scale.
      </h1>
      <h2 class="body-2">
        Product design leader with 15+ years across enterprise platforms, design systems, and design engineering. Currently leading a distributed design team across web, mobile, and connected products at Tive.
      </h2>
      <nav class="navigation-list">
        <ul>
          <li>
            <LinkButton
              href="#my-work"
              label="View Leadership Work"
            />
          </li>
          <li>
            <LinkButton
              href={resumeUrl}
              label="Resume"
              newWindow
            />
          </li>
          <li>
            <LinkButton
              href={linkedinUrl}
              label="LinkedIn"
              newWindow
            />
          </li>
        </ul>
      </nav>
      <p class="credibility-strip body-4 soft">
        15+ years <span aria-hidden="true">·</span> 3 senior designers led <span aria-hidden="true">·</span> 150+ system components <span aria-hidden="true">·</span> 40% &rarr; 90% adoption <span aria-hidden="true">·</span> Design + engineering background
      </p>
    </header>
    <article class="content-section">
      <p class="body-3">
        I lead product design at <a href={tiveUrl} target="_blank"
          >Tive</a
        >, managing designers while staying hands-on across complex enterprise software spanning web, mobile, and connected hardware. 
      </p>
      <p class="body-3">
        Previously: Staff designer at <a href={builtUrl} target="_blank"
          >Built Technologies</a
        > and <a href={mhUrl} target="_blank">Modern Health</a>. Principal designer
        at <a href={anomalieUrl} target="_blank">Anomalie</a> (acquired by David’s
        Bridal). First designer, hybrid design engineer, and later first lead platform designer at <a
          href={sfUrl}
          target="_blank">Stitch Fix</a
        >. Interaction designer at <a href={modClothUrl} target="_blank"
          >ModCloth</a
        >.
      </p>
    </article>
    <!-- <article class="content-section">
      <h2 class="heading-3">Accomplishments</h2>
      <Accomplishments />
    </article> -->
    <article class="content-section" id="my-work">
      <h2 class="heading-3">My Work</h2>
      <MyWork />
    </article>
    <article class="content-section" id="about-me">
      <h2 class="heading-3">About Me</h2>
      <AboutMe>
        <article class="content-section" id="reach-out" slot="aboutMe">
          <h3 class="heading-4">My Design Journey</h3>
          <MyStory />
        </article>
      </AboutMe>
    </article>
    <article class="content-section" id="reach-out">
      <h2 class="heading-3">Reach Out</h2>
      <Contact resumeUrl={resumeUrl} linkedinUrl={linkedinUrl} mediumUrl={mediumUrl} />
    </article>
    <footer>
      <p>
        This site was built with <a
          href="https://github.com/yorthehunter/portfolio-2024"
          target="_blank">Astro and SCSS</a
        >.
      </p>
    </footer>
  </main>
</Layout>

<style>
  .content-section {
    display: flex;
    padding: var(--space-xl) var(--space-s);
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: 2.5rem;
    align-self: stretch;
    max-width: 70.5rem;
    margin: auto;
  }

  .heading-1 {
    font: var(--font-heading-1);
  }

  .heading-2 {
    font: var(--font-heading-2);
  }

  .heading-3 {
    font: var(--font-heading-3);
  }

  .heading-4 {
    font: var(--font-heading-4);
  }

  .body-1 {
    font: var(--font-body-1);
  }

  .body-2 {
    font: var(--font-body-2);
  }

  .body-3 {
    font: var(--font-body-3);
  }

  .body-4 {
    font: var(--font-body-4);
  }
  .navigation-list > ul {
    list-style: none;
    display: flex;
    flex-direction: row;
    gap: var(--space-2xs);
  }

  .navigation-list li {
    display: flex;
  }

  @media only screen and (max-width: 380px) {
    .navigation-list > ul {
      flex-direction: column;
    }
  }
  .all-caps {
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .soft {
    color: var(--color-secondary);
  }

  .eyebrow {
    font: var(--font-body-4);
    margin-bottom: -1.5rem;
  }

  .credibility-strip {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-2xs);
    row-gap: var(--space-3xs);
  }

  footer {
    border-top: 3px solid var(--color-vibrant);

    > p {
      padding: var(--space-xl) var(--space-s);
      max-width: 70.5rem;
      margin: auto;
      font: var(--font-body-4);
    }
  }
</style>
